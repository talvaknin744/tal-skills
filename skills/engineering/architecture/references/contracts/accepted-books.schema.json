{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "accepted-books.schema.json",
  "title": "Accepted books",
  "description": "The coordinator's full collection after source verification. It has its own contract, independent of initial or replacement response cardinality. Replacement preserves the target slot's stable id and every unaffected id. Evidence must be rechecked when a slot's book changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "role", "books"],
  "properties": {
    "record_type": { "const": "accepted_books" },
    "role": { "$ref": "#/definitions/text" },
    "books": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "author", "edition", "source_url", "locator", "fit"],
        "properties": {
          "id": { "type": "string", "pattern": "^b[1-9][0-9]*$" },
          "title": { "$ref": "#/definitions/text" },
          "author": { "$ref": "#/definitions/text" },
          "edition": { "$ref": "#/definitions/text" },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https?://[^\\s/?#]+" },
          "locator": { "$ref": "#/definitions/text" },
          "fit": { "$ref": "#/definitions/text" }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}
