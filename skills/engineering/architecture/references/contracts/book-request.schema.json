{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book-request.schema.json",
  "title": "Book request",
  "description": "One coordinator-mediated selection request. Use a new request_id for each exchange and retain every rejected exact edition in excluded_books.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "role", "question", "request_kind", "excluded_books"],
  "properties": {
    "request_id": { "$ref": "#/definitions/text" },
    "role": { "$ref": "#/definitions/text" },
    "question": { "$ref": "#/definitions/text" },
    "request_kind": { "enum": ["initial", "replacement"] },
    "excluded_books": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/identity" }
    },
    "replaced_book_id": { "type": "string", "pattern": "^b[1-9][0-9]*$" }
  },
  "if": { "properties": { "request_kind": { "const": "replacement" } } },
  "then": {
    "required": ["replaced_book_id"],
    "properties": { "excluded_books": { "type": "array", "minItems": 1 } }
  },
  "else": { "not": { "required": ["replaced_book_id"] } },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "edition"],
      "properties": {
        "title": { "$ref": "#/definitions/text" },
        "author": { "$ref": "#/definitions/text" },
        "edition": { "$ref": "#/definitions/text" }
      }
    }
  }
}
